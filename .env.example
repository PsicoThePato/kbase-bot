# --- Required (Telegram mode) ---
TELEGRAM_BOT_TOKEN=your_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_id_from_userinfobot
ANTHROPIC_API_KEY=your_key_from_console_anthropic_com

# --- Core (all optional, defaults shown) ---
MODEL=claude-sonnet-5
REPO_PATH=/path/to/your/knowledge_base
# SQLite location. Packaged/Nix deploys MUST set this to a writable path.
#DB_PATH=/var/lib/kbase-bot/repo.db
TIMEZONE=America/Sao_Paulo
LOCALE=pt
AUTO_COMMIT=true
SCHEDULER_POLL_MS=15000
# Hard daily cap on LLM API calls (error-loop fuse).
DAILY_LLM_CALL_BUDGET=300

# --- Optional integrations (tool is hidden when the key is unset) ---
# Vector half of KB search + search_history/search_tasks (starts the embedder)
VOYAGE_API_KEY=your_voyage_api_key
#EMBEDDING_POLL_MS=60000
TODOIST_API_KEY=your_todoist_api_key
EXA_API_KEY=your_exa_api_key
GIPHY_API_KEY=your_giphy_api_key

# --- Federation (all off by default; see docs/multiplayer-federation.md) ---
#FEDERATION_ENABLED=true
#FEDERATION_KEY_PATH=/path/to/identity.json   # mix kbase_bot.gen_identity
#FEDERATION_PORT=4040
#FEDERATION_PUBLIC_URL=https://your-host:4040
#FEDERATION_DISPLAY_NAME=KbaseBot
#FEDERATION_PEER_MONTHLY_BUDGET=100
#FEDERATION_UNREACHABLE_ALERT_DAYS=3

# --- Local development ---
#CONSOLE_MODE=true
#PROMPTS_DIR=/path/to/prompt/overrides
#LOG_LEVEL=info
